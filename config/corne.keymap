#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define MISC 4

// Key positions on the 42-key Corne, used by the home-row mods
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

/ {
    behaviors {
        mt_tap: mt_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
        };

        mt_bal: mt_bal {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_BAL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
            // Always tap if pressed within 150 ms of the previous key (stops Space -> Alt while typing)
            require-prior-idle-ms = <150>;
            // Tap, then press again and hold within 175 ms to repeat the tap key
            quick-tap-ms = <175>;
        };

        // Home-row mods, based on urob's "timeless" config:
        // https://github.com/urob/zmk-config#timeless-homerow-mods
        // A key only becomes a modifier when a key on the other hand or a thumb key
        // is pressed and released while it's held. Thumbs are included so that
        // "hold mod, then hold a layer key, then press the target" works.
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Miryoku-style layers: on every layer, the hand that holds the layer key also
        // holds plain modifiers, and the other hand presses the targets.

        default_layer {
            // ----------------------------------------------------------------------------------------
            // |  TAB  |  Q   |  W   |  E   |  R   |  T  |   |  Y  |  U   |  I   |  O   |  P   | BKSP |
            // |ESC/CAP|  A   |S/CTL |D/ALT |F/CMD |  G  |   |  H  |J/CMD |K/ALT |L/CTL |  ;   |  '   |
            // | SHFT  |  Z   |  X   |  C   |  V   |  B  |   |  N  |  M   |  ,   |  .   |  /   | SHFT |
            //                       | CMD  | NAV  |ENT/HYP|  |SPC/ALT| NUM | SYM  |

            display-name = "Base";
            bindings = <
&kp TAB                  &kp Q            &kp W           &kp E           &kp R            &kp T                                 &kp Y                    &kp U            &kp I           &kp O           &kp P               &kp BSPC
&mt_bal CAPSLOCK ESCAPE  &kp A            &hml LCTRL S    &hml LALT D     &hml LGUI F      &kp G                                 &kp H                    &hmr RGUI J      &hmr RALT K     &hmr RCTRL L    &kp SEMI     &kp SQT
&kp LSHFT                &kp Z            &kp X           &kp C           &kp V            &kp B                                 &kp N                    &kp M            &kp COMMA       &kp DOT         &kp FSLH            &kp RSHIFT
                                                          &kp LGUI        &mo NAV          &mt_bal LS(LA(LC(LEFT_GUI))) ENTER    &mt_bal RIGHT_ALT SPACE  &mo NUM          &mo SYM
            >;
        };

        nav_layer {
            // Held by the left thumb: mods on the left hand, navigation on the right.
            // ----------------------------------------------------------------------------------------
            // |       | F11  | F12  | CMD` | CTL` |SC-3 |   | A-← | HOME | END  | A-→  | PGUP |      |
            // |       | SHFT | CTRL | ALT  | CMD  |     |   |  ←  |  ↓   |  ↑   |  →   | PGDN |      |
            // | MISC  |      |      |      |      |     |   |     |      |      |      |      |      |

            display-name = "Nav";
            bindings = <
&trans     &kp F11    &kp F12   &kp LG(GRAVE)  &kp RC(GRAVE)  &kp LG(LS(NUMBER_3))    &kp RA(LEFT)  &kp HOME  &kp END  &kp RA(RIGHT)  &kp PAGE_UP    &trans
&trans     &kp LSHFT  &kp LCTRL &kp LALT       &kp LGUI       &none                   &kp LEFT      &kp DOWN  &kp UP   &kp RIGHT      &kp PAGE_DOWN  &none
&mo MISC   &none      &none     &none          &none          &none                   &none         &none     &trans   &trans         &trans         &trans
                                &trans         &trans         &trans                  &trans        &trans    &trans
            >;
        };

        num_layer {
            // Held by the right thumb: numbers and unshifted symbols on the left, mods on the right.
            // Holding a number key sends the matching F-key, as before.
            // ----------------------------------------------------------------------------------------
            // |       |  -   |  =   |  [   |  ]   |  \  |   |     |      |      |      |      |      |
            // |   `   | 1/F1 | 2/F2 | 3/F3 | 4/F4 |5/F5 |   |     | CMD  | ALT  | CTRL | SHFT |      |
            // |   '   | 6/F6 | 7/F7 | 8/F8 | 9/F9 |0/F10|   |     |      |      |      |      |      |

            display-name = "Num";
            bindings = <
&trans      &kp MINUS            &kp EQUAL            &kp LBKT             &kp RBKT             &kp BSLH                &none  &none      &none      &none      &none      &trans
&kp GRAVE   &mt_tap F1 NUMBER_1  &mt_tap F2 NUMBER_2  &mt_tap F3 NUMBER_3  &mt_tap F4 NUMBER_4  &mt_tap F5 NUMBER_5     &none  &kp RGUI   &kp RALT   &kp RCTRL  &kp RSHFT  &none
&kp SQT     &mt_tap F6 NUMBER_6  &mt_tap F7 NUMBER_7  &mt_tap F8 NUMBER_8  &mt_tap F9 NUMBER_9  &mt_tap F10 NUMBER_0    &none  &none      &none      &none      &none      &trans
                                                      &trans               &trans               &trans                  &trans &trans     &trans
            >;
        };

        sym_layer {
            // Held by the right outer thumb: shifted symbols on the left, mods on the right.
            // ----------------------------------------------------------------------------------------
            // |       |  _   |  +   |  {   |  }   |  |  |   |     |      |      |      |      |      |
            // |   ~   |  !   |  @   |  #   |  $   |  %  |   |     | CMD  | ALT  | CTRL | SHFT |CTL-SP|
            // |   "   |  ^   |  &   |  *   |  (   |  )  |   |     |      |      |      |      |CMD-CTL-Q|
            //                       |  <   |  >   |  :  |   |     |      |      |

            display-name = "Sym";
            bindings = <
&trans      &kp UNDER  &kp PLUS     &kp LBRC      &kp RBRC  &kp PIPE       &none   &none      &none     &none     &none      &trans
&kp TILDE   &kp EXCL   &kp AT_SIGN  &kp HASH      &kp DLLR  &kp PERCENT    &none   &kp RGUI   &kp RALT  &kp RCTRL &kp RSHFT  &kp LC(SPACE)
&kp DQT     &kp CARET  &kp AMPS     &kp ASTERISK  &kp LPAR  &kp RPAR       &none   &none      &none     &none     &none      &kp LG(LC(Q))
                                    &kp LT        &kp GT    &kp COLON      &trans  &trans     &trans
            >;
        };

        miscellaneous_layer {
            display-name = "Misc";
            bindings = <
&bt BT_CLR  &mkp MB4              &mkp MB5              &kp C_PREV         &kp C_PLAY_PAUSE  &kp C_NEXT      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp C_MUTE      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2       &bt BT_SEL 3      &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
                                                        &trans             &trans            &trans          &trans  &trans  &trans
            >;
        };
    };
};
